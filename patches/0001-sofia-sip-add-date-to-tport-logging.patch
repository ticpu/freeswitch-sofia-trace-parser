From d44ee5c41713e06308f11636f0657037fd5e25fe Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C3=A9r=C3=B4me=20Poulin?= <jeromepoulin@gmail.com>
Date: Thu, 10 Jul 2025 13:23:53 -0400
Subject: [PATCH] add date to tport logging

---
 libsofia-sip-ua/tport/tport_logging.c | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/libsofia-sip-ua/tport/tport_logging.c b/libsofia-sip-ua/tport/tport_logging.c
index 4e6a2ac..fa26eb5 100644
--- a/libsofia-sip-ua/tport/tport_logging.c
+++ b/libsofia-sip-ua/tport/tport_logging.c
@@ -339,6 +339,7 @@ void tport_stamp(tport_t const *self, msg_t *msg,
   char name[SU_ADDRSIZE] = "";
   su_sockaddr_t const *su;
   unsigned short second, minute, hour;
+  unsigned short year, month, day;
   /* should check for ifdef HAVE_LOCALTIME_R instead -_- */
 #if defined(HAVE_GETTIMEOFDAY) || defined(HAVE_CLOCK_MONOTONIC)
   struct tm nowtm = { 0 };
@@ -352,10 +353,16 @@ void tport_stamp(tport_t const *self, msg_t *msg,
   second = nowtm.tm_sec;
   minute = nowtm.tm_min;
   hour = nowtm.tm_hour;
+  year = nowtm.tm_year + 1900;
+  month = nowtm.tm_mon + 1;
+  day = nowtm.tm_mday;
 #else
   second = (unsigned short)(now.tv_sec % 60);
   minute = (unsigned short)((now.tv_sec / 60) % 60);
   hour = (unsigned short)((now.tv_sec / 3600) % 24);
+  year = 1970 + (unsigned short)((now.tv_sec / 86400) / 365);
+  month = ((unsigned short)((now.tv_sec / 86400) % 365) / 30) + 1;
+  day = ((unsigned short)((now.tv_sec / 86400) % 365) % 30) + 1;
 #endif
 
   su = msg_addr(msg);
@@ -373,10 +380,10 @@ void tport_stamp(tport_t const *self, msg_t *msg,
   su_inet_ntop(su->su_family, SU_ADDR(su), name, sizeof(name));
 
   snprintf(stamp, TPORT_STAMP_SIZE,
-	   "%s "MOD_ZU" bytes %s %s/[%s]:%u%s%s at %02u:%02u:%02u.%06lu:\n",
+	   "%s "MOD_ZU" bytes %s %s/[%s]:%u%s%s at %04u-%02u-%02u %02u:%02u:%02u.%06lu:\n",
 	   what, (size_t)n, via, self->tp_name->tpn_proto,
 	   name, ntohs(su->su_port), label[0] ? label : "", comp,
-	   hour, minute, second, now.tv_usec);
+	   year, month, day, hour, minute, second, now.tv_usec);
 }
 
 /** Dump the data from the iovec */
-- 
2.53.0

